+#if defined(__ILUVATAR__) && defined(__CUDA_ARCH__)
+// Iluvatar CoreX (ivcore11) clang reports __clang_major__>=14 so CuTe enables
+// CUTE_CLANG_SUPPORTS_CVTA_GENERIC_TO_SHARED, but the corex clang does NOT
+// actually provide the __cvta_generic_to_shared builtin (Iluvatar SWLIB-2972).
+// ivcore11 uses a unified address space; supply a shim returning the low 32 bits
+// of the generic pointer. The CUTLASS SIMT (OpClassSimt) GEMM path used by
+// tiny-cuda-nn does not feed this token into NV shared-memory PTX, so this is a
+// safe compatibility shim for the code paths actually instantiated here.
+CUTE_DEVICE unsigned __cvta_generic_to_shared(void const* ptr) {
+  return static_cast<unsigned>(reinterpret_cast<uintptr_t>(ptr));
+}
+#endif
+
 namespace cute
 {
 
