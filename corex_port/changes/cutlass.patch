@@ -41,6 +41,23 @@
 namespace cutlass {
 namespace arch {
 
+#if defined(__ILUVATAR__)
+// Iluvatar CoreX (ivcore11) has a unified address space in which a generic
+// pointer to __shared__ memory looks like 0xHHHHHHHH_LLLLLLLL, where the high
+// 32 bits are a per-address-space "shared window" base (identical for every
+// __shared__ object in a block) and the low 32 bits are the offset that CUTLASS
+// carries around as its uint32_t smem token (cast_smem_ptr_to_uint /
+// cutlass_get_smem_pointer). ivcore11 provides neither cvta.to.shared nor the
+// ld.shared/st.shared PTX, so the shared_load/shared_store shims below rebuild
+// the real generic pointer as (base | offset). The base is recovered at runtime
+// from a dummy __shared__ anchor (verified: all __shared__ objects share it and
+// base|offset reproduces the exact generic pointer).
+__device__ __forceinline__ uintptr_t tcnn_ivc_smem_base() {
+  __shared__ int tcnn_ivc_smem_anchor;
+  return reinterpret_cast<uintptr_t>(&tcnn_ivc_smem_anchor) & 0xffffffff00000000ull;
+}
+#endif
